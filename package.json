{
  "name": "llamacli",
  "version": "0.1.0",
  "description": "Local llama.cpp AI coding agent CLI (OpenAI-compatible, self-healing, memory-compaction with auto-resume)",
  "type": "module",
  "bin": {
    "llamacli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.3.1",
    "node-fetch": "^3.3.2",
    "yaml": "^2.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
